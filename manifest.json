{
  "manifest_version": 3,
  "name": "Label Highlighter for Plane",
  "version": "1.0.0",
  "description": "Highlight chosen labels, and the cards that carry them, on Plane boards.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["storage", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Label highlight settings",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["https://app.plane.so/*"],
      "js": ["defaults.js", "highlight.js"],
      "css": ["highlight.css"],
      "run_at": "document_idle"
    }
  ]
}
